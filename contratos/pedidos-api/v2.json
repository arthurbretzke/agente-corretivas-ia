{
  "openapi": "3.0.3",
  "info": {
    "title": "API de pedidos",
    "version": "2.0.0",
    "description": "Proposta do time de produto: distância em metros (vinda do serviço de mapas), gorjeta opcional, observação por item e cupom de valor fixo."
  },
  "paths": {
    "/pedidos/resumo": {
      "post": {
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Pedido" } } } },
        "responses": {
          "200": { "description": "Resumo", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Resumo" } } } },
          "422": { "description": "Cupom expirado ou inválido", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Erro" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pedido": {
        "required": ["itens", "distanciaMetros"],
        "properties": {
          "itens": { "type": "array", "items": { "$ref": "#/components/schemas/Item" } },
          "distanciaMetros": { "type": "integer" },
          "gorjeta": { "type": "number" },
          "cupom": { "$ref": "#/components/schemas/Cupom" }
        }
      },
      "Item": {
        "required": ["nome", "quantidade", "precoUnitario"],
        "properties": {
          "nome": { "type": "string" },
          "quantidade": { "type": "integer" },
          "precoUnitario": { "type": "number" },
          "observacao": { "type": "string" }
        }
      },
      "Cupom": {
        "required": ["codigo", "validoAte"],
        "properties": {
          "codigo": { "type": "string" },
          "percentual": { "type": "number" },
          "valorFixo": { "type": "number" },
          "validoAte": { "type": "string" }
        }
      },
      "Resumo": {
        "properties": {
          "subtotal": { "type": "number" },
          "taxaEntrega": { "type": "number" },
          "desconto": { "type": "number" },
          "gorjeta": { "type": "number" },
          "total": { "type": "number" }
        }
      },
      "Erro": {
        "required": ["erro"],
        "properties": {
          "erro": { "type": "string" },
          "codigo": { "type": "string" }
        }
      }
    }
  }
}
